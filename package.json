{
  "name": "batch-payout-backend",
  "version": "1.0.0",
  "description": "One-click batch crypto payout API (NestJS)",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "contracts:setup": "node scripts/forge.mjs install foundry-rs/forge-std@v1.11.0 --no-git",
    "contracts:build": "node scripts/forge.mjs build",
    "contracts:test": "node scripts/forge.mjs test -vv",
    "contracts:deploy": "node scripts/deploy-contracts.mjs"
  },
  "license": "UNLICENSED",
  "type": "commonjs",
  "devDependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "exceljs": "^4.4.0"
  },
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
