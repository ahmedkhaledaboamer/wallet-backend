{
  "name": "batch-payout-backend",
  "version": "1.0.0",
  "description": "One-click batch crypto payout API (NestJS)",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "contracts:setup": "node scripts/forge.mjs install foundry-rs/forge-std@v1.11.0 --no-git",
    "contracts:build": "node scripts/forge.mjs build",
    "contracts:test": "node scripts/forge.mjs test -vv",
    "contracts:deploy": "node scripts/deploy-contracts.mjs",
    "start": "node --enable-source-maps dist/main.js",
    "start:worker": "node --enable-source-maps dist/worker.js",
    "dev": "npm run build && node --enable-source-maps dist/main.js",
    "dev:worker": "npm run build && node --enable-source-maps dist/worker.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/infrastructure/db/cli.ts migrate",
    "db:seed": "tsx src/infrastructure/db/cli.ts seed",
    "db:setup": "tsx src/infrastructure/db/cli.ts setup"
  },
  "license": "UNLICENSED",
  "type": "commonjs",
  "devDependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0",
    "@nestjs/platform-express": "^12.4.0",
    "@nestjs/swagger": "^12.1.1",
    "@noble/hashes": "^2.4.0",
    "bullmq": "^6.7.2",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ulid": "^3.0.2",
    "viem": "^2.57.16",
    "zod": "^4.6.7"
  },
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
