# ── Server ───────────────────────────────────────────────────────────────────
PORT=4000
CORS_ORIGIN=http://localhost:3000

# ── Storage / queue ──────────────────────────────────────────────────────────
# pg + bullmq = production-like (docker compose up). pglite + memory = zero-dependency demo.
DATABASE_DRIVER=pg
DATABASE_URL=postgres://payout:payout@localhost:5432/payout
# PGLITE_DIR=memory://            # or a folder path to persist the embedded DB
QUEUE_DRIVER=bullmq
REDIS_URL=redis://localhost:6379
# SEED_ON_BOOT=true               # pglite only: seed demo data when the DB is empty

# ── Safety switches ──────────────────────────────────────────────────────────
# Dry-run: MEXC withdrawals are simulated (reference ending -FAIL fails, -RECON → reconciliation).
PAYOUTS_DRY_RUN=true
# Real MEXC withdrawals are MAINNET money (MEXC has no withdrawal testnet). Both must be set to go live.
ALLOW_LIVE_MEXC=false
# Demo bearer tokens via GET /demo/users (for the frontend role switcher). Never in production.
DEMO_AUTH=true

# ── Business limits ──────────────────────────────────────────────────────────
MAX_BATCH_TOTAL=250000
MAX_ROWS_MEXC=1000
MAX_ROWS_TRUST_WALLET=200
MAX_FILE_BYTES=2097152
MEXC_MIN_AMOUNT=1
ASSET_MAX_DECIMALS=6
PAYOUT_MAX_ATTEMPTS=5
PAYOUT_RATE_LIMIT_PER_SEC=5
DRY_RUN_MIN_DELAY_MS=300
DRY_RUN_MAX_DELAY_MS=1500
DRY_RUN_CHAIN_CONFIRM_MS=6000

# ── MEXC (only used when PAYOUTS_DRY_RUN=false) ──────────────────────────────
MEXC_BASE_URL=https://api.mexc.com
MEXC_API_KEY=
MEXC_API_SECRET=
MEXC_TIMEOUT_MS=10000
MEXC_RECV_WINDOW_MS=5000
# netWork codes for coin=USDT — confirm with GET /api/v3/capital/config/getall before going live.
MEXC_NETWORK_TRC20=TRX
MEXC_NETWORK_BEP20=BSC
MEXC_NETWORK_ERC20=ETH

# ── Trust Wallet / on-chain (testnets) ───────────────────────────────────────
# Leave a network's RPC/contract/token empty to use the dry-run simulator for it (flagged simulated=true).
TREASURY_ADDRESS=0x8ba1f109551bD432803012645Ac136ddd64DBA72
BEP20_CHAIN_ID=97
BEP20_RPC_URL=
BEP20_PAYOUT_CONTRACT=
BEP20_TOKEN_ADDRESS=
BEP20_TOKEN_DECIMALS=6
BEP20_CONFIRMATIONS=3
ERC20_CHAIN_ID=11155111
ERC20_RPC_URL=
ERC20_PAYOUT_CONTRACT=
ERC20_TOKEN_ADDRESS=
ERC20_TOKEN_DECIMALS=6
ERC20_CONFIRMATIONS=3
VERIFY_POLL_MS=5000
VERIFY_TIMEOUT_MS=1800000

# ── Contract deployment (npm run contracts:deploy -- bsc_testnet|sepolia) ─────
# A throwaway TESTNET key only. Never a real wallet's key.
DEPLOYER_PRIVATE_KEY=
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
SEPOLIA_RPC_URL=
